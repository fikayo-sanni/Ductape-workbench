# API Configuration
# Local dev — API gateway on port 4311 (matches docker compose)
VITE_USE_VITE_PROXY=false
VITE_API_BASE_URL=http://localhost:4311/

# Optional: route via Vite :4310 (Network tab shows :4310, proxied to :4311)
# VITE_USE_VITE_PROXY=true
# VITE_API_GATEWAY_TARGET=http://localhost:4311

# Production
# VITE_API_BASE_URL=https://api.ductape.app/

# OAuth/SSO Configuration (same as ductape-frontend-app)
VITE_LOGIN_ENC_KEY=DAVIDBOWIEBABYBOWIE

# Environment
VITE_APP_ENV=production

# Partnerships: omit or set to anything other than "true" to use the partnerships API
# (same host as VITE_API_BASE_URL, routes under /partnerships/v1).
# VITE_PARTNERSHIPS_USE_DUMMY=true
