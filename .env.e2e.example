# Copy to .env.e2e (gitignored) or export before running Playwright.
# The workbench dev server reads VITE_* from playwright.config webServer.env.

# App under test (Playwright baseURL)
E2E_BASE_URL=http://localhost:4310

# API gateway (users login, workspaces, marketplace when not mocked)
E2E_API_BASE_URL=http://localhost:4311

# Optional: authenticated suites (e2e/auth/* and smoke/login-api.spec.ts)
E2E_EMAIL=your-test-user@example.com
E2E_PASSWORD=your-test-password

# Set to 1 when the dev server is already running (faster local iteration)
# E2E_SKIP_WEB_SERVER=1
